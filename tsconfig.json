{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@peel/core": ["./packages/core/src/index.ts"],
      "@peel/storage": ["./packages/storage/src/index.ts"]
    }
  },
  "include": ["apps/web", "packages", "infra", "tests", "*.ts"]
}
