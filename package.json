{
  "name": "peel",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "pnpm --filter @peel/web dev",
    "build": "pnpm --filter @peel/web build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "mac:dev": "cd apps/native && tauri dev",
    "mac:build": "cd apps/native && tauri build --bundles app",
    "format": "prettier --write apps/web/src packages tests package.json tsconfig.json",
    "test:dynamodb": "node scripts/test-dynamodb-local.mjs",
    "cloud:build": "node scripts/build-cloud-lambda.mjs",
    "cloud:check": "node scripts/check-cloud-lambda.mjs",
    "cloud:prices": "node scripts/observe-cloud-prices.mjs",
    "cloud:identity": "node scripts/observe-cloud-identity.mjs",
    "cloud:source": "node scripts/observe-cloud-source.mjs",
    "cloud:capacity": "node scripts/observe-cloud-capacity.mjs",
    "cloud:audit": "node scripts/observe-cloud-audit.mjs",
    "cloud:iac:render": "node scripts/render-cloud-iac.mjs",
    "cloud:iac:check": ".venv/cloud-iac/bin/cfn-lint --config-file infra/cloud/cfn-lint.json --template artifacts/cloud-iac/data-identity.json artifacts/cloud-iac/artifact-bootstrap.json artifacts/cloud-iac/private-hosting.json artifacts/cloud-iac/cleanup-guard.json artifacts/cloud-iac/cleanup-sentinel.json"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1157.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-global-shortcut": "2.4.1",
    "aws-jwt-verify": "5.2.1",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.1",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
